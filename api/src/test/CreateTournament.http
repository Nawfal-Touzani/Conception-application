Content-Type: application/json

{
  "email": "lea@mail.com",
  "password": "lea"
}

### ------------------------------------------------------
### 1) Create tournament (ADMIN + organizerId correct) 201
### ------------------------------------------------------
POST {{baseUrl}}/tournaments/5
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Tournoi Fortnite",
  "description": "Tournoi entre étudiants",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-05-30",
  "maxParticipant": 8
}

### -------------------------------------------------------------------
### 2) Create tournament FAILED (maxParticipant not power of two) 400
### -------------------------------------------------------------------
POST {{baseUrl}}/tournaments/5
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Tournoi invalide",
  "description": "Test erreur",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-05-30",
  "maxParticipant": 7
}

### ---------------------------------------------
### 3) Create tournament FAILED (past dates) 400
### ---------------------------------------------
POST {{baseUrl}}/tournaments/5
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Tournoi passé",
  "description": "Erreur date",
  "startDate": "2024-01-01",
  "endDate": "2024-01-02",
  "registrationDeadline": "2023-12-30",
  "maxParticipant": 8
}

### ---------------------------------------------------------------------------------
### 4) Deadline after start ⇒ FAILED 400
### ---------------------------------------------------------------------------------
POST {{baseUrl}}/tournaments/5
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Deadline après start",
  "description": "Erreur deadline",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-06-05",
  "maxParticipant": 8
}

### --------------------------------------------------------------------
### 5) OrganizerId ≠ connected admin ⇒ FAILED 403
### --------------------------------------------------------------------
POST {{baseUrl}}/tournaments/1
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Tournoi interdit",
  "description": "Pas le bon organizer",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-05-30",
  "maxParticipant": 8
}

### -----------------------------------------------------------------
### 6) Organizer does not exist ⇒ FAILED 404
### -----------------------------------------------------------------
POST {{baseUrl}}/tournaments/999
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Tournoi inconnu",
  "description": "Organizer inexistant",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-05-30",
  "maxParticipant": 8
}

### --------------------------------------------------------
### 7) No token provided ⇒ FAILED 403
### --------------------------------------------------------
POST {{baseUrl}}/tournaments/1
Content-Type: application/json

{
  "name": "Tournoi sans auth",
  "description": "Erreur sécurité",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-05-30",
  "maxParticipant": 8
}

### ------------------------------------------------------------------
### 8) User is not admin ⇒ FAILED 403
### ------------------------------------------------------------------
POST {{baseUrl}}/tournaments/1
Content-Type: application/json
Authorization: Bearer {{tokenUser}}

{
  "name": "Forbidden user",
  "description": "Pas admin",
  "startDate": "2026-06-01",
  "endDate": "2026-06-02",
  "registrationDeadline": "2026-05-30",
  "maxParticipant": 8
}
