### Get my profile
GET {{baseUrl}}/members/me
Authorization: Bearer {{token}}

### Update my profile
PATCH {{baseUrl}}/members/me
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "speciality": "tacticien",
  "profileImage": "img3.png"
}

### Change password (KO - Wrong old password)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "old",
  "newPassword": "newPswd2026",
  "confirmPassword": "newPswd2026"
}

### Change password (KO - Wrong confirmation password)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "new",
  "newPassword": "newPswd2026",
  "confirmPassword": "newPswd"
}

### Change password (KO - New password same as the previous)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "new",
  "newPassword": "new",
  "confirmPassword": "new"
}

### Change password (KO - Too short)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "luffy",
  "newPassword": "Abc1!",
  "confirmPassword": "Abc1!"
}

### Change password (KO - Missing uppercase)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "luffy",
  "newPassword": "vinci123!",
  "confirmPassword": "vinci123!"
}

### Change password (KO - Missing number)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "luffy",
  "newPassword": "LeoVinci!",
  "confirmPassword": "LeoVinci!"
}

### Change password (KO - Missing special character)
PATCH {{baseUrl}}/members/password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "oldPassword": "new",
  "newPassword": "LeoVinci12",
  "confirmPassword": "LeoVinci12"
