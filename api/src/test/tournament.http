        { "team1": "TEAM_BLAZE", "team2": "?"          }
      ]
    },
    {
      "matches": [
        { "team1": "?", "team2": "?" },
        { "team1": "?", "team2": "?" }
      ]
    },
    {
      "matches": [
        { "team1": "?", "team2": "?" }
      ]
    }
