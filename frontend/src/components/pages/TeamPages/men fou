import { useEffect, useState } from 'react';
import {
  Box,
  Typography,
  Paper,
  Button,
  TextField,
  List,
  ListItem,
  ListItemText,
  InputAdornment,
  Snackbar,
  Alert,
} from '@mui/material';
import SearchIcon from '@mui/icons-material/Search';
import { useAuth } from '../../../../contexts/useAuth';
import * as teamService from '../../../../services/team.service';
import { TeamDto } from '../../../../types/team.types';

type Props = {
  onTeamCreated: () => void; // callback appelé par le parent (TeamPage) après création réussie
};

const JoinOrCreateTeam = ({ onTeamCreated }: Props) => {
  const { user } = useAuth(); // récupère l'utilisateur connecté depuis le contexte global

  //  Fix: extraire le token en variable primitive stable
  // Un objet authHeaders recréé à chaque render causerait une boucle infinie
  // si mis en dépendance de useEffect. On utilise le token (string) à la place.
  const token = user?.token ?? '';

  // États de la page
  const [teams, setTeams] = useState<TeamDto[]>([]); // liste complète des équipes du serveur
  const [filteredTeams, setFilteredTeams] = useState<TeamDto[]>([]); // liste filtrée selon la recherche
  const [search, setSearch] = useState(''); // texte tapé dans le champ de recherche
  const [selectedTeamId, setSelectedTeamId] = useState<number | null>(null); // id de l'équipe cliquée
  const [teamName, setTeamName] = useState(''); // texte tapé dans le champ "créer une équipe"
  const [snack, setSnack] = useState<{
    open: boolean; // true = notification visible
    msg: string; // texte affiché
    severity: 'success' | 'error'; // couleur : vert ou rouge
  }>({ open: false, msg: '', severity: 'success' });

  //  Fix: dépendance sur `token` (string) et non sur `authHeaders` (objet recréé à chaque render)
  // Charge la liste des équipes au montage et si le token change
  useEffect(() => {
    if (!token) return;
    teamService
      .getTeams(token) // GET /api/teams → retourne toutes les équipes
      .then((data) => {
        if (Array.isArray(data)) {
          setTeams(data); // stocke la liste complète
          setFilteredTeams(data); // initialise aussi la liste filtrée avec tout
        }
      })
      .catch(() => {});
  }, [token]);

  // Filtre la liste affichée à chaque fois que la recherche ou les équipes changent
  useEffect(() => {
    if (!search.trim()) {
      setFilteredTeams(teams); // recherche vide → affiche tout
    } else {
      setFilteredTeams(
        teams.filter((t) =>
          t.name.toLowerCase().includes(search.toLowerCase()), // insensible à la casse
        ),
      );
    }
    setSelectedTeamId(null); // désélectionne si on change la recherche
  }, [search, teams]);

  const createTeam = async () => {
    if (!teamName.trim()) return; // sécurité : ne pas envoyer un nom vide
    try {
      const res = await teamService.createTeam(token, teamName); // POST /api/teams

      if (res.status === 201) {
        onTeamCreated(); // succès → notifie le parent (TeamPage) pour recharger
      } else if (res.status === 409) {
        // 409 Conflict : le nom est déjà pris
        setSnack({
          open: true,
          msg: "Ce nom d'équipe existe déjà.",
          severity: 'error',
        });
      } else if (res.status === 400) {
        // 400 Bad Request : nom invalide (trop court, caractères interdits...)
        setSnack({
          open: true,
          msg: "Nom d'équipe invalide.",
          severity: 'error',
        });
      } else {
        setSnack({
          open: true,
          msg: 'Erreur lors de la création.',
          severity: 'error',
        });
      }
    } catch {
      setSnack({
        open: true,
        msg: 'Impossible de joindre le serveur.', // erreur réseau
        severity: 'error',
      });
    }
  };

  const joinTeam = async () => {
    if (selectedTeamId === null) return; // sécurité : ne pas envoyer sans sélection
    try {
      const res = await teamService.sendJoinRequest(token, selectedTeamId); // POST /api/teams/{id}/membership-requests

      if (res.ok || res.status === 201) {
        setSnack({
          open: true,
          msg: 'Demande envoyée avec succès !',
          severity: 'success',
        });
        setSelectedTeamId(null); // désélectionne après envoi
      } else {
        setSnack({
          open: true,
          msg: "Erreur lors de l'envoi.",
          severity: 'error',
        });
      }
    } catch {
      setSnack({
        open: true,
        msg: 'Impossible de joindre le serveur.',
        severity: 'error',
      });
    }
  };

  return (
    <Box
      sx={{
        flexGrow: 1,
        backgroundColor: '#1a2744',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        px: 2,
      }}
    >
      <Box
        sx={{
          display: 'flex',
          gap: 4,
          width: '100%',
          maxWidth: 860,
          alignItems: 'flex-start',
        }}
      >
        {/* ── Left: Rejoindre ── */}
        <Paper
          elevation={0}
          sx={{
            flex: 1,
            borderRadius: '12px',
            p: 3.5,
            backgroundColor: '#fff',
            minHeight: 360,
            display: 'flex',
            flexDirection: 'column',
          }}
        >
          <Typography
            variant="h5"
            sx={{
              fontWeight: 800,
              color: '#1a2744',
              mb: 0.5,
              textAlign: 'center',
            }}
          >
            Rejoindre une team
          </Typography>
          <Box
            sx={{
              width: 40,
              height: 3,
              backgroundColor: '#1a2744',
              borderRadius: 2,
              mx: 'auto',
              mb: 2.5,
            }}
          />

          <TextField
            fullWidth
            placeholder="Nom de l'équipe"
            value={search}
            onChange={(e) => setSearch(e.target.value)} // met à jour search → déclenche le useEffect de filtre
            size="small"
            InputProps={{
              endAdornment: (
                <InputAdornment position="end">
                  <SearchIcon sx={{ color: '#1a2744' }} />
                </InputAdornment>
              ),
              sx: { borderRadius: '6px', fontSize: '0.9rem' },
            }}
            sx={{ mb: 1 }}
          />

          <Box
            sx={{
              flex: 1,
              backgroundColor: '#1a2744',
              borderRadius: '8px',
              p: 1,
              mb: 2,
              minHeight: 160,
              overflow: 'auto',
            }}
          >
            <List disablePadding>
              {filteredTeams.length === 0 && (
                <ListItem>
                  <ListItemText
                    primary="Aucune équipe trouvée"
                    primaryTypographyProps={{
                      color: 'rgba(255,255,255,0.5)',
                      fontSize: '0.85rem',
                    }}
                  />
                </ListItem>
              )}
              {filteredTeams.map((team) => (
                <ListItem
                  key={team.id}
                  onClick={() => setSelectedTeamId(team.id)} // sélectionne l'équipe cliquée
                  sx={{
                    cursor: 'pointer',
                    borderRadius: '6px',
                    px: 1.5,
                    py: 0.6,
                    backgroundColor:
                      selectedTeamId === team.id
                        ? 'rgba(255,255,255,0.2)' // surligne l'équipe sélectionnée
                        : 'transparent',
                    '&:hover': { backgroundColor: 'rgba(255,255,255,0.1)' },
                    transition: 'background 0.15s',
                  }}
                >
                  <ListItemText
                    primary={team.name}
                    primaryTypographyProps={{
                      color: '#fff',
                      fontSize: '0.9rem',
                      fontWeight: selectedTeamId === team.id ? 600 : 400, // gras si sélectionné
                    }}
                  />
                </ListItem>
              ))}
            </List>
          </Box>

          <Box sx={{ textAlign: 'center' }}>
            <Button
              variant="contained"
              disabled={selectedTeamId === null} // désactivé tant qu'aucune équipe n'est sélectionnée
              onClick={joinTeam}
              sx={{
                backgroundColor: '#1a2744',
                borderRadius: '6px',
                px: 3,
                py: 1,
                fontWeight: 700,
                fontSize: '0.9rem',
                textTransform: 'none',
                boxShadow: 'none',
                '&:hover': { backgroundColor: '#243358' },
                '&:disabled': { backgroundColor: '#ccc', color: '#888' },
              }}
            >
              Envoyer demande
            </Button>
          </Box>
        </Paper>

        {/* ── Right: Créer ── */}
        <Paper
          elevation={0}
          sx={{
            flex: 1,
            borderRadius: '12px',
            p: 3.5,
            backgroundColor: '#fff',
            minHeight: 360,
            display: 'flex',
            flexDirection: 'column',
          }}
        >
          <Typography
            variant="h5"
            sx={{
              fontWeight: 800,
              color: '#1a2744',
              mb: 0.5,
              textAlign: 'center',
            }}
          >
            Créer une team
          </Typography>
          <Box
            sx={{
              width: 40,
              height: 3,
              backgroundColor: '#1a2744',
              borderRadius: 2,
              mx: 'auto',
              mb: 3,
            }}
          />

          <Typography
            sx={{
              color: '#1a2744',
              fontWeight: 600,
              mb: 1.5,
              fontSize: '0.95rem',
            }}
          >
            Entrez le nom de votre futur équipe :
          </Typography>

          <TextField
            fullWidth
            value={teamName}
            onChange={(e) => setTeamName(e.target.value)}
            onKeyDown={(e) => e.key === 'Enter' && createTeam()} // permet de créer en appuyant sur Entrée
            size="small"
            sx={{
              mb: 3,
              '& .MuiOutlinedInput-root': {
                backgroundColor: '#e8eaf0',
                borderRadius: '6px',
                '& fieldset': { border: 'none' },
              },
            }}
          />

          <Box sx={{ mt: 'auto', textAlign: 'center' }}>
            <Button
              variant="contained"
              disabled={!teamName.trim()} // désactivé si le champ est vide
              onClick={createTeam}
              sx={{
                backgroundColor: '#1a2744',
                borderRadius: '6px',
                px: 4,
                py: 1,
                fontWeight: 700,
                fontSize: '0.9rem',
                textTransform: 'none',
                boxShadow: 'none',
                '&:hover': { backgroundColor: '#243358' },
                '&:disabled': { backgroundColor: '#ccc', color: '#888' },
              }}
            >
              Créer
            </Button>
          </Box>
        </Paper>
      </Box>

      {/* Notification toast en bas de page */}
      <Snackbar
        open={snack.open}
        autoHideDuration={4000} // disparaît automatiquement après 4 secondes
        onClose={() => setSnack((s) => ({ ...s, open: false }))} // ...s garde msg et severity, écrase open
        anchorOrigin={{ vertical: 'bottom', horizontal: 'center' }}
      >
        <Alert
          severity={snack.severity}
          onClose={() => setSnack((s) => ({ ...s, open: false }))}
        >
          {snack.msg}
        </Alert>
      </Snackbar>
    </Box>
  );
};

export default JoinOrCreateTeam;